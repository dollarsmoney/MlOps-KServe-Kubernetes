# Copy to .env and fill in. .env is git-ignored — never commit real values.

# ---- AWS (Phase 2 onward: DVC remote, MLflow artifacts, model storage) ----
AWS_REGION=us-east-1
S3_BUCKET=recsys-mlops-<your-unique-suffix>
# Credentials come from ~/.aws/credentials locally, and from IRSA in-cluster (Phase 14).
# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here unless you have no alternative.

# ---- MLflow (Phase 3) ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=recommendation-ranker
MLFLOW_ARTIFACT_ROOT=s3://recsys-mlops-<your-unique-suffix>/mlflow

# ---- PostgreSQL (Phase 7) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recsys
POSTGRES_USER=recsys
POSTGRES_PASSWORD=changeme

# ---- Redis (Phase 7) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Kafka (Phase 8) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=recsys

# ---- KServe (Phase 6) ----
KSERVE_ENDPOINT=http://localhost:8080/v1/models/recommendation-ranker:predict
KSERVE_NAMESPACE=recsys

# ---- Local cluster ----
MINIKUBE_PROFILE=recsys
